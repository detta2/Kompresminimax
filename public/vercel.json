{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/kompres-pdf", "destination": "/index.html" },
    { "source": "/ganti-background-foto", "destination": "/index.html" },
    { "source": "/resize-pas-foto", "destination": "/index.html" },
    { "source": "/gabung-pdf", "destination": "/index.html" },
    { "source": "/pisah-pdf", "destination": "/index.html" },
    { "source": "/susun-pdf", "destination": "/index.html" },
    { "source": "/scan-dokumen", "destination": "/index.html" },
    { "source": "/konversi-pdf", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
